# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- AWS (region, S3 for blog images, CloudFront CDN) ---
AWS_REGION=af-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_DOMAIN=xxxxxxxx.cloudfront.net

# --- AWS credentials (IAM user, server-side only) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key

# --- NextAuth (admin sign-in) ---
NEXTAUTH_SECRET=run-openssl-rand-base64-32
NEXTAUTH_URL=https://ilesanmi.vercel.app

# --- AWS SES (admin magic-link emails) ---
AWS_SES_REGION=af-south-1
AWS_SES_FROM=your-verified-email@example.com

# --- Admin allowlist (single user) ---
ADMIN_EMAIL=ilesanmierioluwavictor@gmail.com

# --- Contact form (Gmail SMTP for visitor-to-you messages) ---
CONTACT_GMAIL_USER=ilesanmierioluwavictor@gmail.com
CONTACT_GMAIL_APP_PASSWORD=your-16-char-app-password
